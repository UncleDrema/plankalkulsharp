int = 8.0
pointer = 8.0
node = (int, pointer)
node_pool = 100 x node
pair = (int, int)

P0 test(V0[:int], V1[:pointer]) -> R0[:int]
  // Выделяем участок памяти в виде пула узлов для адресации
  alloc_pool() => Z0[:node_pool]
  // Создаем связный список из V0 узлов, начиная с адреса 1
  create_list(Z0, V0) => Z1
  // Разворачиваем связный список Z1 и получаем указатель на голову развернутого списка
  reverse_list(Z0, Z1) => Z2
  // Получаем значение первого узла развернутого списка по адресу Z2
  Z0[(V1 - 1)] => Z3
  // Возвращаем значение первого узла развернутого списка
  Z3[1] => R0
END

// Выделить пул узлов размером 100
P1 alloc_pool() -> R0[:node_pool]
  FOR Z0 FROM 0 TO 99 {
    0 => Z1[0:node]
    0 => Z1[1]
    Z1 => R0[Z0]
  }
END

// Выделить список заданной длины из пула
P4 create_list(V0[:node_pool], V1[:int]) -> R0[:pointer]
  (V1 > 100) -> 0 => R0
  (V1 <= 0)  -> 0 => R0
  (V1 > 0 & V1 <= 100) -> {
    // Идем по адресам Z0 от 1 до размера списка
    FOR Z0 FROM 1 TO V1 {
      // Заполняем данными новый узел - значение равно индексу, указатель на следующий узел равен адрес + 1 (кроме последнего узла, у которого указатель 0)
      Z0 => Z1[0:node]
      (Z0 != V1) -> Z0 + 1 => Z1[1]
      (Z0 = V1)  -> 0 => Z1[1]
      Z1 => V0[(Z0 - 1)]
    }
    0 => V0[(V1 - 1).1]
    1 => R0
  }
END

// Развернуть связный список
// было  1 -> 2 -> 3 -> 4 -> 5 ->
// стало 5 -> 4 -> 3 -> 2 -> 1 ->
// на входе  1 -> ...
// на выходе 5 -> ...
/*
Алгоритм: дано cur_addr - указатель на начало списка
Надо найти: адрес конца списка
prev_addr = null
next_addr = cur_addr->next
while next_addr != null:
  curr_addr->next = prev_addr
  prev_addr = cur_addr
  cur_addr = next_addr
  next_addr = cur_addr->next_addr
curr_addr->next = prev_addr
return cur_addr

промежуточные переменные: prev_addr (Z0), next_addr (Z1)
*/
P5 reverse_list(V0[:node_pool], V1[:pointer]) -> R0[:pointer]
  0 => Z0[:int] // prev_addr
  V0[(V1 - 1).1] => Z1 // next_addr
  W {
    Z1 != 0 -> {
      Z0 => V0[(V1 - 1).1]
      V1 => Z0
      Z1 => V1
      V0[(V1 - 1).1] => Z1
    }
  }
  Z0 => V0[(V1 - 1).1]
  V1 => R0
END

// Demo: several programs with meaningful hardcoded calls
// max(3, 7) = 7, sum_to(5) = 15, arithmetic(3, 4) = 13

A1 = S1.8

P1 max (V0[:8.0], V1[:8.0]) -> R0[:8.0]
  V0[:8.0] => Z0[:8.0]
  (Z0[:8.0] < V1[:8.0]) -> V1[:8.0] => Z0[:8.0]
  Z0[:8.0] => R0[:8.0]
END

P2 sum_to (V0[:8.0]) -> R0[:8.0]
  0 => Z0[:8.0]
  FOR Z1[:8.0] FROM 0 TO V0[:8.0] {
    Z0[:8.0] + Z1[:8.0] => Z0[:8.0]
  }
  Z0[:8.0] => R0[:8.0]
END

P3 arithmetic (V0[:8.0], V1[:8.0]) -> R0[:8.0]
  V0[:8.0] + V1[:8.0] => Z0[:8.0]
  Z0[:8.0] * 2 => Z1[:8.0]
  Z1[:8.0] - 1 => R0[:8.0]
END

P4 abs (V0[:8.0]) -> R0[:8.0]
  V0[:8.0] => Z0[:8.0]
  (Z0[:8.0] < 0) -> {
    0 - Z0[:8.0] => Z0[:8.0]
  }
  Z0[:8.0] => R0[:8.0]
END

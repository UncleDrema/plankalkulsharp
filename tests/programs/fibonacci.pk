// Fibonacci number by index
// fib(0) = 0, fib(1) = 1, fib(n) = fib(n-1) + fib(n-2)
// Input: V0 = index (0-based)
// Output: R0 = fib(V0)
//
// Examples: fib(0)=0, fib(1)=1, fib(5)=5, fib(10)=55

P1 fib (V0[:8.0]) -> R0[:8.0]
  0 => Z0[:8.0]
  1 => Z1[:8.0]
  0 => Z2[:8.0]
  W {
    (Z2[:8.0] < V0[:8.0]) -> {
      Z0[:8.0] + Z1[:8.0] => Z3[:8.0]
      Z1[:8.0] => Z0[:8.0]
      Z3[:8.0] => Z1[:8.0]
      Z2[:8.0] + 1 => Z2[:8.0]
    }
  }
  Z0[:8.0] => R0[:8.0]
END

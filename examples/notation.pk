// Вкладка «Нотация Plankalkül»: V — номер, K — компонент, S — структура.
// При аргументах 5 3 результат 98: 16 + P2(12) + P3(54) + P4(8) + P5(5) + P6(3).
// Скобки в AST сохраняют порядок вычислений.
int = 32.0
pair = (int, int)

P0 notation(V0[:int], V1[:int]) -> R0[:int]
  (V0 + V1) * 2 => R0
  count_pairs(V0, V1) => Z0
  R0 + Z0 => R0
  ranges() => Z1
  skip_and_stop() => Z2
  find_index() => Z3
  nested_indices() => Z4
  R0 + Z1 + Z2 + Z3 + Z4 => R0
END

// Число пар (i, j), где 1 <= i <= V0, 1 <= j <= V1 и j <= i.
// Для 5 и 3: 1 + 2 + 3 + 3 + 3 = 12. Неположительная граница даёт 0.
// Два вложенных W и условие внутри: проверка высоких квадратных скобок.
P2 count_pairs(V0[:int], V1[:int]) -> R0[:int]
  0 => R0
  1 => Z0
  W {
    Z0 <= V0 -> {
      1 => Z1
      W {
        Z1 <= V1 -> {
          Z1 <= Z0 -> {
            R0 + 1 => R0
          }
          Z1 + 1 => Z1
        }
      }
      Z0 + 1 => Z0
    }
  }
END

// Здесь хорошо видна строка K: два разных компонента одной переменной V0.
P1 components(V0[:pair]) -> R0[:int]
  V0[0] + V0[1] => R0
END

// Все направления перебора; сумма 6 + 6 + 9 + 12 + 12 + 9 = 54.
P3 ranges() -> R0[:int]
  0 => R0
  W1 i0 (4) { R0 + i0 => R0 }
  W2 i0 (4) { R0 + i0 => R0 }
  W3 i0 (2, 5) { R0 + i0 => R0 }
  W4 i0 (5, 2) { R0 + i0 => R0 }
  W5 i0 (5, 2) { R0 + i0 => R0 }
  W5 i0 (2, 5) { R0 + i0 => R0 }
END

// Пропускаем 2, выходим на 5: сумма 0 + 1 + 3 + 4 = 8.
P4 skip_and_stop() -> R0[:int]
  0 => R0
  W1 i0 (10) {
    i0 = 2 => FIN
    i0 = 5 => FIN2
    R0 + i0 => R0
  }
END

// Условный блок добавляет уровень: FIN3 завершает весь цикл. Результат 5.
P5 find_index() -> R0[:int]
  -1 => R0
  W1 i0 (10) {
    i0 = 5 -> {
      i0 => R0
      FIN3
    }
  }
  FIN
  99 => R0 // Пропускается: FIN выше завершает процедуру.
END

// Граница внутреннего цикла заново фиксируется при каждом входе. Результат 3.
P6 nested_indices() -> R0[:int]
  0 => R0
  W1 i0 (3) {
    W1 i1 (i0) {
      R0 + 1 => R0
    }
  }
END

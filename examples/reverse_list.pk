// Динамический односвязный список.
// V0 — число узлов N, V1 — значение выбранного узла.
// Для 1 <= V1 <= V0 возвращается значение next после разворота, иначе -1.
// Все выделенные узлы освобождаются до завершения программы.

int = 32.0
node = (int, @node)

P0 test(V0[:int], V1[:int]) -> R0[:int]
  (V0 < 1 | V1 < 1 | V1 > V0) -> -1 => R0
  (V0 >= 1 & V1 >= 1 & V1 <= V0) -> {
    NIL => Z0[:@node]
    NIL => Z1[:@node]
    NIL => Z2[:@node]
    W1 i0 (V0) {
      i0 + 1 => Z3[:int]
      @node => Z4[:@node]
      Z3 => Z4[@.0]
      NIL => Z4[@.1]
      Z1 = NIL -> Z4 => Z0
      Z1 != NIL -> {
        Z4 => Z1[@.1]
      }
      Z4 => Z1
      Z3 = V1 -> Z4 => Z2
    }
    reverse_nodes(Z0) => Z0
    Z2[@.1] => Z5[:@node]
    Z5 = NIL -> 0 => R0
    Z5 != NIL -> Z5[@.0] => R0
    W {
      Z0 != NIL -> {
        Z0[@.1] => Z1
        Z0 => @
        Z1 => Z0
      }
    }
  }
END

P1 reverse_nodes(V0[:@node]) -> R0[:@node]
  NIL => Z0[:@node]
  V0 => Z1[:@node]
  W {
    Z1 != NIL -> {
      Z1[@.1] => Z2[:@node]
      Z0 => Z1[@.1]
      Z1 => Z0
      Z2 => Z1
    }
  }
  Z0 => R0
END

// Демонстрация фрагментации. Размер кучи при запуске: 64 байта.
// V0 = 0: разделение и слияние блоков, успешное завершение с результатом 0.
// V0 = 1: намеренная нехватка непрерывного блока, завершение с ошибкой.
// В мониторе установите задержку 500 мс и наблюдайте карту кучи.

int = 32.0
word = 64.0
pair = (word, word)
triple = (word, word, word)

P0 fragmentation(V0[:int]) -> R0[:int]
  // Четыре блока по 16 байт: A | B | C | D. Куча заполнена.
  @pair => Z0
  11 => Z0[@.0]
  @pair => Z1
  22 => Z1[@.0]
  @pair => Z2
  33 => Z2[@.0]
  @pair => Z3
  44 => Z3[@.0]

  // Освобождаем не соседние блоки, сначала D, затем B.
  Z3 => @
  Z1 => @
  // A | свободно 16 | C | свободно 16.
  // Всего свободно 32 байта, но ни одного участка размером 24 нет.
  V0 = 1 -> {
    @triple => Z4
    // При куче 64 байта выполнение сюда не дойдёт.
    Z4 => @
  }

  // Удаляем C: свободные соседи объединяются в участок 48 байт.
  Z2 => @
  // Новый блок E занимает первые 24 байта этого участка (смещение 16).
  @triple => Z5
  55 => Z5[@.0]
  // A | E (24) | свободно 24.
  @word => Z6
  66 => Z6[@]
  // A | E (24) | F (8) | свободно 16.

  Z0 => @
  // Первый подходящий участок — бывший A, хотя он освобождён последним.
  @word => Z7
  77 => Z7[@]
  // G (8) | свободно 8 | E (24) | F (8) | свободно 16.

  Z5 => @
  // Свободные 8 и 24 байта объединяются; F пока разделяет свободную память.
  Z6 => @
  // Освобождение F объединяет свободные участки слева и справа.
  Z7 => @
  // Вся куча снова свободна: один блок 64 байта, живых объектов нет.
  0 => R0
END

// CLI: run examples/lists.pk -- '[2,3,4]'
// Results: [4,3,2]; [[0,4],[1,3],[2,2]]; [7,8]; [2,3,4]; 3
int = 32.0
P0 main(V0[:* x int]) -> (R0[:* x int], R1[:* x (int,int)], R2[:* x int], R3[:* x int], R4[:int])
    reverse(V0) => R0
    Nr(R0) => R1
    Qz([1,2], [7,8]) => Z0
    Sp(Z0, 1) => R2
    insert(V0, N(V0), 99) => Z1
    remove(Z1, N(V0)) => R3
    N(Lz([1], [2,3])) => R4
END

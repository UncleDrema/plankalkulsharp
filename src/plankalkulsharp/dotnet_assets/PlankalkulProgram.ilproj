<Project Sdk="Microsoft.NET.Sdk.IL/10.0.0-preview.2.25163.2">
  <PropertyGroup>
    <OutputType>Library</OutputType>
    <TargetFramework>net10.0</TargetFramework>
  </PropertyGroup>
  <ItemGroup>
    <Reference Include="PlankalkulRuntime" Condition="'$(PlankalkulRuntimePath)' != ''">
      <HintPath>$(PlankalkulRuntimePath)</HintPath>
      <Private>false</Private>
    </Reference>
  </ItemGroup>
</Project>
